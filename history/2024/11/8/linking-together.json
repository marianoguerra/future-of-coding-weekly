    {
        "user": "UDRF3ALP4",
        "type": "message",
        "ts": "1731198045.158869",
        "client_msg_id": "272aee1a-0cda-4a58-b2cc-73cc3af240df",
        "text": "Thanks for the further examples!\n\n<@UBN9AFS0N> more UI inspo, nice!\n\n<@U07BD7U4S4R> interesting I noticed for myself that I prefer information to mostly on grow vertically but seeing your spy, I'm wondering whether opinions differ more on that than I thought.\n\n<@UFEQUBNNT> I remember seeing this paper a while ago but it left my memory, thanks for bringing it back. It's kind of sad (but reflective of the state of programming), that even the authors only describe it as database UI when I don't know why we'd want to look at nested data *anywhere* in any other way.\nFor Dataset I think I did not find what was meant",
        "team": "T5TCAFTA9",
        "thread_ts": "1731109091.361599",
        "parent_user_id": "UDRF3ALP4",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "y4T3d",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Thanks for the further examples!\n\n"
                            },
                            {
                                "type": "user",
                                "user_id": "UBN9AFS0N"
                            },
                            {
                                "type": "text",
                                "text": " more UI inspo, nice!\n\n"
                            },
                            {
                                "type": "user",
                                "user_id": "U07BD7U4S4R"
                            },
                            {
                                "type": "text",
                                "text": " interesting I noticed for myself that I prefer information to mostly on grow vertically but seeing your spy, I'm wondering whether opinions differ more on that than I thought.\n\n"
                            },
                            {
                                "type": "user",
                                "user_id": "UFEQUBNNT"
                            },
                            {
                                "type": "text",
                                "text": " I remember seeing this paper a while ago but it left my memory, thanks for bringing it back. It's kind of sad (but reflective of the state of programming), that even the authors only describe it as database UI when I don't know why we'd want to look at nested data "
                            },
                            {
                                "type": "text",
                                "text": "anywhere ",
                                "style": {
                                    "bold": true
                                }
                            },
                            {
                                "type": "text",
                                "text": "in any other way.\nFor Dataset I think I did not find what was meant"
                            }
                        ]
                    }
                ]
            }
        ]
    },
    {
        "user": "U07BD7U4S4R",
        "type": "message",
        "ts": "1731226378.855919",
        "edited": {
