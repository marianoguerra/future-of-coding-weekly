        "ts": "1758370600.354969",
        "client_msg_id": "1e18821a-670a-4c87-8ade-43f638cd05ec",
        "text": "Running libraries with distinct privileges implies a security-relevant boundary around the library. That's something that traditional PL-based libraries don't have.\n\nIn Unix-like architectures, such boundaries are available only for processes. Does WASM change that?",
        "team": "T5TCAFTA9",
        "thread_ts": "1758325971.603289",
        "parent_user_id": "UCUSW7WVD",
        "blocks": [
            {
