        "client_msg_id": "77bc725f-2bec-42c9-867f-19cfad3019ed",
        "text": "Having the sequential \"notebook\" inside an infinite canvas seems nice! I often drift around and get a bit disorganized working in an infinite canvas, but having at least part of the canvas stay linear seems helpful when I want some structure",
        "team": "T5TCAFTA9",
        "thread_ts": "1765947472.781179",
        "parent_user_id": "UC2A2ARPT",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "BYmGO",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Having the sequential \"notebook\" inside an infinite canvas seems nice! I often drift around and get a bit disorganized working in an infinite canvas, but having at least part of the canvas stay linear seems helpful when I want some structure"
                            }
                        ]
                    }
                ]
            }
        ],
