    },
    {
        "user": "UE6EFEPTQ",
        "type": "message",
        "ts": "1740906363.757539",
        "client_msg_id": "b7618dd6-be94-423a-a49e-ab6f7f35c2a8",
        "text": "A Data-First project must allow collaboration even if you don't use it. Local-First is \"mandatory\" because if you are going to need collaboration you'll need two people's Data-focused UI to be focusing on the same data, otherwise it's not collaboration! It doesn't need \"sync\" and conflict resolution even: just anything that allows two+ folk to see the same thing, while maintaining their sovereignty over their own data.",
        "team": "T5TCAFTA9",
        "thread_ts": "1740781231.434539",
        "parent_user_id": "UE6EFEPTQ",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "zjoA2",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "A Data-First project must allow collaboration even if you don't use it. Local-First is \"mandatory\" because if you are going to need collaboration you'll need two people's Data-focused UI to be focusing on the same data, otherwise it's not collaboration! It doesn't need \"sync\" and conflict resolution even: just anything that allows two+ folk to see the same thing, while maintaining their sovereignty over their own data."
                            }
                        ]
                    }
                ]
            }
        ]
    }
]