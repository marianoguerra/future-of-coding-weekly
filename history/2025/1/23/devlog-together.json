    {
        "user": "U02E4DAQGSZ",
        "type": "message",
        "ts": "1737638953.331799",
        "edited": {
            "user": "U02E4DAQGSZ",
            "ts": "1737638977.000000"
        },
        "client_msg_id": "da87115a-0fe5-4640-8ba4-e036b7377747",
        "text": "it runs JS fine, its just file:// is considered its own origin so it can't do cross origin requests... e.g. fetching an external image. The security context is different than normal. There are work arounds because JS can manufacture in-memory URLs that are, by construction, in the same origin. But yeah, you are in heavy yak shaving territory at that point, and you need a good mental model of the security model to work around those limitations if you need to.",
        "team": "T5TCAFTA9",
        "thread_ts": "1737612150.216079",
        "parent_user_id": "UCUSW7WVD",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "DjHC2",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "it runs JS fine, its just file:// is considered its own origin so it can't do cross origin requests... e.g. fetching an external image. The security context is different than normal. There are work arounds because JS can manufacture in-memory URLs that are, by construction, in the same origin. But yeah, you are in heavy yak shaving territory at that point, and you need a good mental model of the security model to work around those limitations if you need to."
                            }
                        ]
                    }
                ]
            }
        ],
