                                        }
                                    },
                                    {
                                        "type": "text",
                                        "text": " )"
                                    }
                                ]
                            },
                            {
                                "type": "rich_text_section",
                                "elements": [
                                    {
                                        "type": "text",
                                        "text": "Add a child node (using "
