    {
        "user": "U07PYD02V2S",
        "type": "message",
        "ts": "1760736916.713559",
        "client_msg_id": "af3a5822-5aac-42fe-9a82-d1d7ee2bcd5c",
        "text": "since I'm starting my search for fulltime roles I did something I've managed to avoid doing for years now and made a (dundun) <https://www.mattcurtis.me/|personal website>\n\nalso trying to make more things that are sort of... just for me, you know?\n\nanyway, idk if any of you have used Astro before (it's sort of similar to Gatsby, if you're familiar with that) but I used it for this and it's pretty neat. near first-class support for turning markdown into pages and querying and sorting collections of markdown. really great if you're building a text-heavy site. plus you can pull in components from your UI framework of choice, like React or Vue.\n\nalso got to play with a few SVG/CSS animation features I've never had the chance to fully use in a production site\n\nwould love to get any thoughts the folks here have! i feel like personal sites are sort of becoming more rare (might be just me, though)",
        "team": "T5TCAFTA9",
        "thread_ts": "1760736916.713559",
        "reply_count": 7,
        "reply_users_count": 5,
        "latest_reply": "1760821663.495879",
        "reply_users": [
            "U02E4DAQGSZ",
            "U07PYD02V2S",
            "UMQ6LR9NZ",
            "UC2A2ARPT",
            "U06SS0DHZD1"
        ],
        "is_locked": false,
        "subscribed": false,
        "attachments": [
            {
                "image_url": "https://www.mattcurtis.me/og/general.jpg",
                "image_width": 1200,
                "image_height": 630,
                "image_bytes": 395029,
                "from_url": "https://www.mattcurtis.me/",
                "id": 1,
                "original_url": "https://www.mattcurtis.me/",
                "fallback": "Matt Curtis",
                "text": "The personal site of Matt Curtis",
                "title": "Matt Curtis",
                "title_link": "https://www.mattcurtis.me/",
                "service_name": "mattcurtis.me"
            }
        ],
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "5LaA5",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "since I'm starting my search for fulltime roles I did something I've managed to avoid doing for years now and made a (dundun) "
                            },
                            {
                                "type": "link",
                                "url": "https://www.mattcurtis.me/",
                                "text": "personal website"
                            },
                            {
                                "type": "text",
                                "text": "\n\nalso trying to make more things that are sort of... just for me, you know?\n\nanyway, idk if any of you have used Astro before (it's sort of similar to Gatsby, if you're familiar with that) but I used it for this and it's pretty neat. near first-class support for turning markdown into pages and querying and sorting collections of markdown. really great if you're building a text-heavy site. plus you can pull in components from your UI framework of choice, like React or Vue.\n\nalso got to play with a few SVG/CSS animation features I've never had the chance to fully use in a production site\n\nwould love to get any thoughts the folks here have! i feel like personal sites are sort of becoming more rare (might be just me, though)"
                            }
                        ]
                    }
                ]
            }
        ],
