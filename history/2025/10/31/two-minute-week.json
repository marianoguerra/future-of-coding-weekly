            "ts": "1762103542.000000"
        },
        "client_msg_id": "87202c62-0d47-42a2-9a4d-cafae37daa48",
        "text": "After this experiment and talking to <@UC2A2ARPT> I realized a much simpler solution is to grow the hit area of the thumb.\n\n<https://mastodon.social/@spiralganglion/115469389148175886|https://mastodon.social/@spiralganglion/115469389148175886>\n\n<https://git.sr.ht/~akkartik/carousel2.love/commit/c84cda3eec839c25fafddb2eb98b02bcb3244360|https://git.sr.ht/~akkartik/carousel2.love/commit/c84cda3eec839c25fafddb2eb98b02bcb3244360>",
        "team": "T5TCAFTA9",
        "thread_ts": "1761891896.324109",
        "parent_user_id": "UCUSW7WVD",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "FvYVJ",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "After this experiment and talking to "
                            },
                            {
                                "type": "user",
                                "user_id": "UC2A2ARPT"
                            },
                            {
                                "type": "text",
                                "text": " I realized a much simpler solution is to grow the hit area of the thumb.\n\n"
                            },
                            {
