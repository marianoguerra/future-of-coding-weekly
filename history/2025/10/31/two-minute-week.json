    {
        "user": "U05PY5AQCA2",
        "type": "message",
        "ts": "1762102414.157419",
        "client_msg_id": "AC00E84B-B6C5-4F60-B317-F004C98F6AC5",
        "text": "Typically, if the viewport is showing 1/10th of the document, the thumb takes up 1/10th of the scroll bar; if 1/100th, 1/100th. At that point, the thumb is so small, it\u2019s a bad UI experience \u2014\u00a0hard to see, hard to click on.\n\nRather, the reduction should be logarithmic, so that even at 1/1000th, the thumb is smaller, but still usable.",
        "team": "T5TCAFTA9",
        "thread_ts": "1761891896.324109",
        "parent_user_id": "UCUSW7WVD",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "tyI4U",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Typically, if the viewport is showing 1/10th of the document, the thumb takes up 1/10th of the scroll bar; if 1/100th, 1/100th. At that point, the thumb is so small, it\u2019s a bad UI experience \u2014\u00a0hard to see, hard to click on.\n\nRather, the reduction should be logarithmic, so that even at 1/1000th, the thumb is smaller, but still usable."
                            }
                        ]
                    }
                ]
            }
        ]
    },
