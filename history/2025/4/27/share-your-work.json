    {
        "user": "U03CEGR3HSL",
        "type": "message",
        "ts": "1745765243.661099",
        "edited": {
            "user": "U03CEGR3HSL",
            "ts": "1745770767.000000"
        },
        "client_msg_id": "7e1c785b-f81c-466a-a27a-45785e109161",
        "text": "I have heard it said that when people are impressed by a pig dancing, they are not impressed by how well it dances. They are impressed that it is dancing at all. \n\nSimilarly, I have not heard this paper praised for its depth, rigor, or comprehensiveness. It is usually praised for the fact that he was able to think about these ideas at all given the extreme limitations of the computers that were functioning at the time.\n\nThe discussion of rules, and the fact that there must be rules for interpreting them, reminds me of the excellent discussion in Formalization in Program Development (1982) by Peter Naur.\n\nPeter Naur was also skeptical of Turing's thinking on AI. See Thinking and Turing's Test (1986).",
        "team": "T5TCAFTA9",
        "thread_ts": "1745728882.975249",
        "parent_user_id": "UC2A2ARPT",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "HYhSQ",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "I have heard it said that when people are impressed by a pig dancing, they are not impressed by how well it dances. They are impressed that it is dancing at all. \n\nSimilarly, I have not heard this paper praised for its depth, rigor, or comprehensiveness. It is usually praised for the fact that he was able to think about these ideas at all given the extreme limitations of the computers that were functioning at the time.\n\nThe discussion of rules, and the fact that there must be rules for interpreting them, reminds me of the excellent discussion in Formalization in Program Development (1982) by Peter Naur.\n\nPeter Naur was also skeptical of Turing's thinking on AI. See Thinking and Turing's Test (1986)."
                            }
                        ]
                    }
                ]
            }
        ]
    },
