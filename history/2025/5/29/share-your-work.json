    {
        "user": "UMQ6LR9NZ",
        "type": "message",
        "ts": "1748560568.453089",
        "client_msg_id": "294a28a1-8d61-4e85-92bc-7196c4e2dc10",
        "text": "I maybe went overboard <@U06MJU6LBN3> \u2014 I\u2019ve added some very basic optional auth to tweety to make it a tad be more usable/safe.\n\n<https://github.com/eli-oat/tweety/commit/9366b5f1f4a8cb2e1bdb9c42383cad99b3231138|Here\u2019s the commit on my fork> \u2014 if it is your jam I can create a PR for you.",
        "team": "T5TCAFTA9",
        "thread_ts": "1748533162.167309",
        "parent_user_id": "U06MJU6LBN3",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "Zx4xd",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "I maybe went overboard "
                            },
                            {
                                "type": "user",
                                "user_id": "U06MJU6LBN3"
                            },
                            {
                                "type": "text",
                                "text": " \u2014 I\u2019ve added some very basic optional auth to tweety to make it a tad be more usable/safe.\n\n"
                            },
                            {
                                "type": "link",
                                "url": "https://github.com/eli-oat/tweety/commit/9366b5f1f4a8cb2e1bdb9c42383cad99b3231138",
                                "text": "Here\u2019s the commit on my fork"
                            },
                            {
