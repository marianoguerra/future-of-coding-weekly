                                "type": "text",
                                "text": " - "
                            },
                            {
                                "type": "link",
                                "url": "https://tailrmade.app/"
                            },
                            {
                                "type": "text",
                                "text": " - a visual app builder that runs entirely in your browser. Think of it as a way to prototype and build interactive web apps without starting from scratch every time.\n"
                            },
                            {
                                "type": "text",
                                "text": "How it works:",
                                "style": {
                                    "bold": true
                                }
                            },
                            {
                                "type": "text",
                                "text": "\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_list",
                        "elements": [
                            {
                                "type": "rich_text_section",
                                "elements": [
                                    {
                                        "type": "text",
                                        "text": "Node-based system for logic (connect data sources, APIs, transformations, etc.)"
                                    }
                                ]
                            },
                            {
                                "type": "rich_text_section",
                                "elements": [
                                    {
                                        "type": "text",
                                        "text": "Visual UI layer on top where you build dashboards and interfaces"
                                    }
                                ]
                            },
                            {
                                "type": "rich_text_section",
                                "elements": [
                                    {
                                        "type": "text",
                                        "text": "For every app you create, you can \"look under the hood/UI\" at the logic and see/tweak everything"
                                    }
                                ]
                            },
                            {
                                "type": "rich_text_section",
                                "elements": [
                                    {
                                        "type": "text",
                                        "text": "Basic AI assistance (requires signup) that uses the same building blocks instead of being a black box"
                                    }
                                ]
