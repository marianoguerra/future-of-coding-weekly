    {
        "user": "U09LA28NZFT",
        "type": "message",
        "ts": "1775071803.790199",
        "client_msg_id": "ee586d59-2f64-44c3-af5e-1e38707336f1",
        "text": "<@UGWUJUZHT> I really enjoyed this set of articles.  Here are some of the quotes that resonate strongly for me:\nFrom article 1:\n&gt; CPUs and memory are now effectively free. The original justification evaporated. What remained was the notation, now mistaken for ground truth.\nFrom article 2:\n&gt; Every notation has a sweet spot \u2014 a class of problems it expresses clearly and cheaply. Outside that sweet spot, the notation fights you.\nFrom article 3:\n&gt; Every one of these domains is stateful by nature. The state does not go away because the notation ignores it.\n-\n&gt; Hidden state is not safe state. It is state that is harder to reason about, harder to test, and harder to modify.\nFrom article 4:\n&gt; The question is not \u201ccan this notation express the problem?\u201d The question is \u201cdoes this notation make the problem easy to express, easy to reason about, easy to modify, and easy to communicate?\u201d\nFrom article 5:\n&gt; A GPL must be expressive enough to handle every problem domain, which means it cannot be optimally expressive for any particular one.\n&gt; Little languages \u2014 small, purpose-built notations for specific problem domains \u2014 make the opposite trade.\nThe mismatch between the dominant notation(s) and the things we really care about when designing software screams at me everyday.",
        "team": "T5TCAFTA9",
        "thread_ts": "1774982848.103119",
        "parent_user_id": "UGWUJUZHT",
        "blocks": [
            {
                "type": "rich_text",
                "block_id": "gEVth",
                "elements": [
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "user",
                                "user_id": "UGWUJUZHT"
                            },
                            {
                                "type": "text",
                                "text": " I really enjoyed this set of articles.  Here are some of the quotes that resonate strongly for me:\nFrom article 1:\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "CPUs and memory are now effectively free. The original justification evaporated. What remained was the notation, now mistaken for ground truth."
                            }
                        ]
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "From article 2:\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Every notation has a sweet spot \u2014 a class of problems it expresses clearly and cheaply. Outside that sweet spot, the notation fights you."
                            }
                        ]
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "From article 3:\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Every one of these domains is stateful by nature. The state does not go away because the notation ignores it."
                            }
                        ]
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "-\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "Hidden state is not safe state. It is state that is harder to reason about, harder to test, and harder to modify."
                            }
                        ]
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "From article 4:\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "The question is not \u201ccan this notation express the problem?\u201d The question is \u201cdoes this notation make the problem easy to express, easy to reason about, easy to modify, and easy to communicate?\u201d"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "From article 5:\n"
                            }
                        ]
                    },
                    {
                        "type": "rich_text_quote",
                        "elements": [
                            {
                                "type": "text",
                                "text": "A GPL must be expressive enough to handle every problem domain, which means it cannot be optimally expressive for any particular one.\nLittle languages \u2014 small, purpose-built notations for specific problem domains \u2014 make the opposite trade."
                            }
                        ]
                    },
                    {
                        "type": "rich_text_section",
                        "elements": [
                            {
                                "type": "text",
                                "text": "The mismatch between the dominant notation(s) and the things we really care about when designing software screams at me everyday."
                            }
                        ]
                    }
                ]
            }
        ],
